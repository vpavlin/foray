#!/usr/bin/env bash
# The list's browser tools (foray_browser.py), run by pi in the session's
# cage. Python and Camoufox live in the session's directory (.browser), which
# outlives the cage, and are installed the first time — by setup.sh, with
# --install, so a session never waits for a download.
set -euo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
b="$here/.browser"
export XDG_CACHE_HOME="$b/cache"
if [ ! -f "$b/ready" ]; then
    mkdir -p "$b"
    python3 -m venv "$b/venv" >&2
    "$b/venv/bin/pip" install -q camoufox >&2
    "$b/venv/bin/python" -m camoufox fetch >&2
    touch "$b/ready"
fi
[ "${1:-}" = --install ] && exit 0
exec "$b/venv/bin/python" "$here/browser/foray_browser.py"
