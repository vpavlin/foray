#!/usr/bin/env bash
# The list's browser tools (foray_browser.py), run by pi in the session's
# cage. Python and Camoufox live in the session's directory (.browser), which
# outlives the cage. setup.sh installs them (--install); should they be
# missing when pi starts this, the install runs in the background — pi does
# not wait minutes for a server — and the tools say so until it is done.
# Other arguments (--region, from the session's .pi/mcp.json) go to the server.
set -euo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
b="$here/.browser"
export XDG_CACHE_HOME="$b/cache"
install() {
    mkdir -p "$b"
    exec 9>"$b/.lock"
    flock 9
    [ -f "$b/ready" ] && return 0
    rm -rf "$b/venv" "$b/cache"
    python3 -m venv "$b/venv"
    "$b/venv/bin/pip" install -q camoufox
    "$b/venv/bin/python" -m camoufox fetch
    touch "$b/ready"
}
if [ "${1:-}" = --install ]; then
    install >&2
    exit 0
fi
if [ ! -f "$b/ready" ]; then
    mkdir -p "$b"
    (install >"$b/install.log" 2>&1 &)
    FORAY_BROWSER_NOT_READY=1 exec python3 -I "$here/browser/foray_browser.py" "$@"
fi
exec "$b/venv/bin/python" -I "$here/browser/foray_browser.py" "$@"
